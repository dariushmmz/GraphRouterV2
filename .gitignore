# Ignore all files and folders starting with .
.*
!.gitignore

# Ignore environment files
.env
.env.*
*.env

# Ignore Python virtual environments
venv/
.venv/
env/

# Ignore common cache files
__pycache__/
*.py[cod]
*$py.class

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore IDE settings
.vscode/
.idea/